# Copy to .env and adjust. Every value below is read by the API and worker processes.

# --- Database -----------------------------------------------------------------
# API/worker talk to PostgreSQL through asyncpg. Alembic rewrites the driver prefix
# to psycopg/asyncpg automatically, so one URL is enough.
DATABASE_URL=postgresql+asyncpg://webhooks:webhooks@localhost:5432/webhooks
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- HTTP API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Reference receiver -------------------------------------------------------
# Only read by the reference test receiver (`webhooks-receiver`, or the Compose
# `receiver` service); the API and worker ignore them.
RECEIVER_HOST=0.0.0.0
RECEIVER_PORT=9000

# --- Delivery -----------------------------------------------------------------
# Per-attempt HTTP timeout for outbound webhook requests (seconds).
DELIVERY_TIMEOUT_SECONDS=10
# Total number of attempts per event before it becomes dead-letter.
DELIVERY_MAX_ATTEMPTS=5
# Exponential backoff: delay = min(BASE * 2**(attempt-1), MAX), plus optional jitter.
DELIVERY_BACKOFF_BASE_SECONDS=2
DELIVERY_BACKOFF_MAX_SECONDS=300
# Fraction of the computed delay added as uniform random jitter (0 disables).
DELIVERY_BACKOFF_JITTER_RATIO=0.2
# Maximum response body bytes stored per attempt (diagnostics only).
DELIVERY_RESPONSE_SNIPPET_BYTES=512

# --- Worker -------------------------------------------------------------------
# Unique per worker process; lease fencing relies on it. Compose sets it explicitly.
WORKER_ID=
WORKER_BATCH_SIZE=10
WORKER_CONCURRENCY=8
WORKER_POLL_INTERVAL_SECONDS=1
# Lease length must stay comfortably above DELIVERY_TIMEOUT_SECONDS: a worker that
# dies without finishing leaves the attempt claimed until the lease expires.
WORKER_LEASE_SECONDS=60

# --- Observability ------------------------------------------------------------
LOG_LEVEL=INFO
# json (default, one JSON object per line) or console (human readable).
LOG_FORMAT=json
